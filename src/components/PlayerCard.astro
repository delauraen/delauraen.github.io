---
import { jamLog, site } from '../site';
import Icon from './Icon.astro';

/** RPG-style character sheet shown in the home page hero. */
const stats = [
	{ label: 'Jams cleared', value: String(jamLog.length) },
	{ label: 'Largest party', value: '9' },
	{ label: 'Engines', value: 'Godot · UE5' },
];
---

<aside class="player-card" aria-label="Player card">
	<div class="header">
		<div class="avatar">
			<Icon icon="ghost" size="2.75rem" />
		</div>
		<div>
			<p class="eyebrow">Player 1</p>
			<p class="name">{site.name}</p>
			<p class="handle">@{site.handle}</p>
		</div>
	</div>

	<dl class="class-info">
		<div>
			<dt>Class</dt>
			<dd>{site.role}</dd>
		</div>
		<div>
			<dt>Guild</dt>
			<dd>Blizzard Entertainment</dd>
		</div>
		<div>
			<dt>Current title</dt>
			<dd>Staff Test Analyst</dd>
		</div>
	</dl>

	<ul class="stats">
		{
			stats.map(({ label, value }) => (
				<li>
					<span class="value">{value}</span>
					<span class="label">{label}</span>
				</li>
			))
		}
	</ul>

	<div class="quest">
		<p class="quest-label"><Icon icon="scroll" size="1.1em" /> Active quest</p>
		<p>QA → Game Design</p>
		<div class="xp" role="presentation"><span></span></div>
	</div>
</aside>

<style>
	.player-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		width: 100%;
		max-width: 26rem;
		padding: 1.75rem;
		border-radius: 1.5rem;
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		box-shadow: var(--shadow-lg);
		font-size: var(--text-base);
	}

	/* Gradient border, matching the nav pill. */
	.player-card::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: var(--gradient-accent);
		border-radius: inherit;
		z-index: -1;
	}

	.header {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.avatar {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 1rem;
		color: var(--accent-text-over);
		background: var(--gradient-accent);
		box-shadow: var(--shadow-md);
	}

	.eyebrow,
	dt,
	.label,
	.quest-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.name {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-0);
		line-height: 1.2;
	}

	.handle {
		color: var(--link-color);
	}

	.class-info {
		display: grid;
		gap: 0.5rem;
		margin: 0;
	}

	.class-info div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px dashed var(--gray-700);
	}

	dd {
		margin: 0;
		text-align: end;
		color: var(--gray-100);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.stats li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		padding: 0.75rem 0.25rem;
		text-align: center;
		border-radius: 0.75rem;
		background: var(--gray-999_40);
		border: 1px solid var(--gray-800);
	}

	.value {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-0);
		line-height: 1.1;
	}

	.stats .label {
		font-size: 0.7rem;
	}

	.quest {
		display: grid;
		gap: 0.375rem;
		color: var(--gray-100);
	}

	.quest-label {
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	.xp {
		height: 0.625rem;
		border-radius: 999rem;
		background: var(--gray-800);
		overflow: hidden;
	}

	.xp span {
		display: block;
		width: 70%;
		height: 100%;
		border-radius: inherit;
		background: var(--gradient-accent);
		animation: fill 1.2s ease-out both;
	}

	@keyframes fill {
		from {
			width: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.xp span {
			animation: none;
		}
	}
</style>
