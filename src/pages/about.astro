---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { jamLog, site } from '../site';
---

<BaseLayout
	title={`About | ${site.name}`}
	description={`About ${site.name}: Staff Test Analyst at Blizzard Entertainment, moving into game design.`}
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero title="About" tagline="QA professional by day, game designer by night." />

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I'm a Staff Test Analyst at Blizzard Entertainment. My job is finding the ways a game can
						break, which also means learning why it's fun when it doesn't.
					</p>
					<p>
						Since 2023 I've entered {jamLog.length} game jams, starting with a solo Ludum Dare entry
						where I taught myself Unreal Engine 5, Blender and Aseprite from scratch. Since then I've
						led design on team projects, including level design for a nine-person team and designing,
						coding and producing a character-swap puzzle platformer.
					</p>
					<p>
						I keep leveling up my design skills through game jams and portfolio projects. You can play my games on <a href={site.itch}
							>itch.io</a
						>.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Loadout</h2>
				<div class="content">
					<ul class="loadout">
						<li><strong>Engines:</strong> Godot, Unreal Engine 5 (Blueprints)</li>
						<li><strong>Art:</strong> Blender, Aseprite</li>
						<li>
							<strong>Design:</strong> level layout, core loops, tuning values, scoping
							for deadlines
						</li>
						<li>
							<strong>QA:</strong> test planning, bug triage, edge-case hunting, player-first
							readability
						</li>
					</ul>
				</div>
			</section>
			<section>
				<h2 class="section-title">Say Hi</h2>
				<div class="content">
					<p>
						I'm open to game design roles and jam collaborations. Email me at <a
							href={`mailto:${site.email}`}>{site.email}</a
						> or find me on <a href={site.linkedin}>LinkedIn</a>.
					</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.loadout {
		display: grid;
		gap: 0.5rem;
		padding-inline-start: 1.25rem;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
