---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';

import CallToAction from '../../components/CallToAction.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/guides/routing/#dynamic-routes
export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

/** Rows for the "game info" panel. */
const stats = [
	{ label: 'Jam', value: data.jam, href: data.jamUrl },
	{ label: 'Theme', value: data.theme },
	{ label: 'My role', value: data.role },
	{ label: 'Party size', value: data.teamSize === 1 ? 'Solo' : `${data.teamSize} people` },
	{ label: 'Engine', value: data.engine },
	{ label: 'Platforms', value: data.platforms.join(', ') },
].filter((stat) => stat.value);
---

<BaseLayout title={data.title} description={data.description}>
	<div class="stack gap-20">
		<div class="stack gap-15">
			<header>
				<div class="wrapper stack gap-2">
					<a class="back-link" href="/work/"><Icon icon="arrow-left" /> Level Select</a>
					<Hero title={data.title} align="start">
						<div class="details">
							<div class="tags">
								{data.tags.map((t) => <Pill>{t}</Pill>)}
							</div>
							<p class="description">{data.description}</p>
						</div>
					</Hero>
				</div>
			</header>
			<main class="wrapper">
				<div class="stack gap-10 content">
					<Image src={data.img} alt={data.img_alt || ''} width={1300} class="cover" />

					<aside class="game-info" aria-label="Game info">
						<dl>
							{
								stats.map(({ label, value, href }) => (
									<div>
										<dt>{label}</dt>
										<dd>{href ? <a href={href}>{value}</a> : value}</dd>
									</div>
								))
							}
						</dl>
						<CallToAction href={data.itchUrl}>
							{data.playInBrowser ? 'Play in Browser' : 'Download on itch.io'}
							<Icon icon="game-controller" size="1.2em" />
						</CallToAction>
					</aside>

					<div class="content">
						<Content />
					</div>
				</div>
			</main>
		</div>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	header {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.back-link {
		display: none;
	}

	.details {
		display: flex;
		flex-direction: column;
		padding: 0.5rem;
		gap: 1.5rem;
		justify-content: space-between;
		align-items: center;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
	}

	.description {
		font-size: var(--text-lg);
		max-width: 54ch;
	}

	.content {
		max-width: 65ch;
		margin-inline: auto;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.5rem 0;
	}

	.cover {
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	.game-info {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.game-info dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 1rem 1.5rem;
		margin: 0;
	}

	.game-info dt {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.game-info dd {
		margin: 0;
		color: var(--gray-0);
	}

	.game-info :global(a) {
		align-self: center;
	}

	.content :global(img) {
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
	}

	.content :global(table) {
		width: 100%;
		border-collapse: collapse;
	}

	.content :global(th),
	.content :global(td) {
		padding: 0.5rem 0.75rem;
		text-align: start;
		border-bottom: 1px solid var(--gray-800);
	}

	.content :global(th) {
		font-family: var(--font-brand);
		color: var(--gray-0);
	}

	.content :global(code) {
		padding: 0.1em 0.4em;
		border-radius: 0.375rem;
		background: var(--gray-800);
		font-size: 0.9em;
	}

	.content :global(blockquote) {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		line-height: 1.1;
		padding-inline-start: 1.5rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		color: var(--gray-0);
	}

	.back-link,
	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus,
	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.back-link {
			display: block;
			align-self: flex-start;
		}

		.details {
			flex-direction: row;
			gap: 2.5rem;
		}

		.content :global(table) {
		width: 100%;
		border-collapse: collapse;
	}

	.content :global(th),
	.content :global(td) {
		padding: 0.5rem 0.75rem;
		text-align: start;
		border-bottom: 1px solid var(--gray-800);
	}

	.content :global(th) {
		font-family: var(--font-brand);
		color: var(--gray-0);
	}

	.content :global(code) {
		padding: 0.1em 0.4em;
		border-radius: 0.375rem;
		background: var(--gray-800);
		font-size: 0.9em;
	}

	.content :global(blockquote) {
			font-size: var(--text-2xl);
		}
	}
</style>
